{
  "name": "gacha-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GACHA desktop app",
  "author": "goowesh",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "cd client && npm run build",
    "build:desktop": "cd client && npm run build:desktop",
    "start": "electron .",
    "dist": "npm run build:desktop && electron-builder",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never",
    "dist:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "publish": "npm run build:desktop && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ru.gacha.desktop",
    "productName": "GACHA",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "L-GMA",
        "repo": "gacha"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "GACHA-${version}-setup.${ext}"
    },
    "mac": {
      "target": [
        { "target": "zip", "arch": ["x64", "arm64"] },
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.social-networking",
      "identity": null
    }
  }
}

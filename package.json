{
  "name": "gacha-desktop",
  "version": "0.5.44",
  "private": true,
  "description": "GACHA desktop app",
  "author": "goowesh",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "cd client && npm run build",
    "build:desktop": "cd client && npm run build:desktop",
    "start": "electron .",
    "dist": "npm run build:desktop && electron-builder",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never",
    "dist:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "publish": "npm run build:desktop && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ru.gacha.desktop",
    "productName": "GACHA",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "L-GMA",
        "repo": "gacha",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "GACHA использует доступ к записи звука для трансляции системного аудио в голосовых каналах."
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "GACHA-${version}-setup.${ext}"
    }
  }
}
